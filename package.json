{
  "name": "shiftline",
  "private": true,
  "version": "1.0.0",
  "description": "Concept prototype of an AI quality copilot for factory shift leads.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
